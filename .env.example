[TEMPLATE]
# === DATABASE ===
DB_PASSWORD=natasha_epic_2024

# === OpenAI (генерация сценария) ===
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# === ElevenLabs (озвучка) ===
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# === YouTube ===
# Видимость загружаемых видео: private (по умолчанию) | unlisted | public
YOUTUBE_PRIVACY=private
# Сам OAuth2-доступ настраивается в n8n: credential "Google Account" (googleApi)
# со скоупом https://www.googleapis.com/auth/youtube.upload — выбирается в самом n8n.

# === TikTok (Content Posting API) ===
# Токен доступа: https://developers.tiktok.com → Content Posting API,
# скоупы video.upload + video.publish (нужно одобрение приложения!)
TIKTOK_ACCESS_TOKEN=your-tiktok-token
# SELF_ONLY (тест) | PUBLIC_TO_EVERYONE (публикация)
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# === Instagram (Graph API) ===
# Бизнес-аккаунт, связанный со страницей Facebook
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-ig-long-lived-token
# ОБЯЗАТЕЛЬНО: Instagram сам скачивает видео по публичному https-URL.
# Выложите файл на VPS/nginx (или любой хостинг) и укажите ссылку.
INSTAGRAM_VIDEO_URL=https://your-server.example.com/media/natasha-final.mp4

# === Telegram ===
TELEGRAM_BOT_TOKEN=5123456789:ABCDefGHIjklmnOPqrSTUVwxyz
# Чат/канал администратора, куда приходит видео на проверку и отчёт
TELEGRAM_CHAT_ID=your-admin-chat-id

# === Фон видео ===
NATASHA_BG_IMAGE=/home/node/assets/bg.jpg

# === n8n ===
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

