      "id": "r",
      "name": "Read RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ],
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length) return [];\nconst sd = $getWorkflowStaticData('global');\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = (h * 0x01000193) >>> 0;\n  }\n  return h.toString(16).padStart(8, '0');\n}\nfor (const item of items) {\n  const it = item.json;\n  const stable = it.guid || it.link || (it.title || '');\n  const content_id = 'rss-' + fnv1a(String(stable));\n  if (sd.lastContentId === content_id) continue;\n  const snippet = (it.contentSnippet || it.content || '').slice(0, 400);\n  const text = `${it.title || ''}\n\n${snippet}\n\n${it.link || ''}`;\n  return [{ json: { content_id, source: 'rss', created_at: new Date().toISOString(), title: it.title || '', text, caption: text, platforms: ['telegram'], link: it.link || null, image_url: null, video_url: null } }];\n}\nreturn [];"
      },
      "id": "f",
      "name": "Format Latest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/epicstar-publish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d",
      "name": "Send To Distributor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
