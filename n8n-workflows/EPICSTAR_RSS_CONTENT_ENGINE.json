        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global'); const cid = $('Format Latest').first().json.content_id; sd.lastContentId = cid; return [{json:{marked: cid}}];"
      },
      "type": "n8n-nodes-base.code",
