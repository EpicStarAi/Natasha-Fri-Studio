        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst text = b.text || b.caption || '';\nconst image = b.image_url; const video = b.video_url;\nlet m, p;\nif (video) { m='sendVideo'; p={chat_id: -1004457068141, video, caption: text}; }\nelse if (image) { m='sendPhoto'; p={chat_id: -1004457068141, photo: image, caption: text}; }\nelse { m='sendMessage'; p={chat_id: -1004457068141, text}; }\nreturn [{json:{tg_method:m, payload:p}}];"
